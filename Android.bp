android_app {
    name: "OdinSettings",
    srcs: ["src/**/*.java"],
    resource_dirs: ["res"],
    certificate: "platform",
    privileged: true,
    platform_apis: true,
    static_libs: ["com.ayn.fan-java"],
    manifest: "AndroidManifest.xml",
}

java_test_host {
    name: "OdinSettingsHostTests",
    srcs: [
        "src/com/odin2/odinsettings/domain/**/*.java",
        "src/com/odin2/odinsettings/display/**/*.java",
        "src/com/odin2/odinsettings/hardware/**/*.java",
        "src/com/odin2/odinsettings/policy/**/*.java",
        "src/com/odin2/odinsettings/service/**/*.java",
        "tests/src/**/*.java",
    ],
    test_options: {
        unit_test: true,
    },
}
